# Blood Bank Management System — Environment Variables
# Copy this file to .env and fill in your local values.

# ------- MySQL Connection -------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=bloodbank_db

# Constructed from the above — used by SQLAlchemy (aiomysql async driver)
DATABASE_URL=mysql+aiomysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DB}

# ------- Security -------
SECRET_KEY=changeme_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------- App Config -------
APP_TITLE=Blood Bank Management System
APP_VERSION=1.0.0
DEBUG=true
