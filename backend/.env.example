# ── Database ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bloodbank

# ── Application ─────────────────────────────────────────
APP_DEBUG=false

# ── Auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-generate-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Demo login (disable in production) ──────────────────
ALLOW_DEMO_LOGIN=true

# ── CORS (comma-separated list of allowed frontend URLs) ─
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
